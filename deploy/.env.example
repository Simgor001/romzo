# Generate secrets once: relay init > .env.secrets
PUBLIC_ORIGIN=https://relay.example.com
# Public relay: * allows arbitrary HTTP(S) web origins. Use exact origins for private deployments.
CLIENT_ORIGINS=*
# Management UI origins remain restricted, independently of public clients.
ADMIN_ORIGINS=https://relay.example.com
LISTEN=127.0.0.1:9224

# password requires CREATE_PASSWORD; anonymous permits password-free creation.
# turnstile and oauth (or turnstile+oauth) require GRANT_KEY plus the matching
# provider configuration below; room creation then trusts grants only.
CREATE_AUTH=password
CREATE_PASSWORD=
AUTH_SALT=
TICKET_KEY=
# Signs creation grants for turnstile/oauth attestation; required when
# CREATE_AUTH includes turnstile or oauth. Generated by `relay init`.
GRANT_KEY=
# Management key: metrics and room shutdown; empty disables management.
METRICS_KEY=

# Optional Cloudflare Turnstile attestation; empty disables it. Setting
# TURNSTILE_SECRET requires turnstile in CREATE_AUTH. Siteverify responses are
# pinned to the PUBLIC_ORIGIN hostname unless TURNSTILE_HOSTNAMES overrides it.
TURNSTILE_SECRET=
# TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# Public site key for SDK-rendered widgets and the combined OAuth gate.
TURNSTILE_SITEKEY=
# Optional widget action enforcement (^[a-z0-9_-]{1,64}$); empty skips it.
# TURNSTILE_ACTION=
# TURNSTILE_HOSTNAMES=relay.example.com

# Optional OAuth2/OIDC attestation (GitHub, itch.io, generic providers);
# requires oauth in CREATE_AUTH. All endpoints HTTPS (loopback HTTP allowed
# for tests). The callback URL to register with the provider is
# PUBLIC_ORIGIN + /api/v1/auth/oauth/callback.
# OAUTH_PROVIDER=github
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
# OAUTH_USERINFO_URL=https://api.github.com/user
# OAUTH_SCOPES=read:user
# OAUTH_NAME_FIELD=login
# Only exact proxy IP CIDRs; leave empty for direct access.
TRUSTED_PROXIES=

MAX_ROOMS=64
MAX_CONNECTIONS=512
MAX_UNAUTHENTICATED=64
MAX_ROOM_CONNECTIONS=32
FRAMES_PER_SECOND=64
BYTES_PER_SECOND=1048576
# Aggregate authenticated inbound WS bytes across all connections from one IP.
IP_BYTES_PER_SECOND=1048576
# Opaque canonical JSON options; may be lowered, never above 4096 bytes.
MAX_OPTIONS_BYTES=4096

# Monitoring counters and room shutdown records, stored in the mounted data directory.
METRICS_HISTORY_FILE=/data/rooms.json

# Deployment limits; unlike the other built-in limits, these default to disabled.
MAX_ROOM_TRAFFIC_BYTES=1073741824
# Maximum age since first observation, including offline time; 0 disables it.
MAX_ROOM_AGE_SECONDS=21600
# Aggregate outbound enqueue rate across all rooms, with a two-second burst.
NODE_OUTBOUND_BYTES_PER_SECOND=1048576

# Explicitly enable creator IP history; no collection by default.
RECORD_CREATOR_IP=false

# Participant numbers. Required by play.html; one relay process per state file.
MEMBER_STATE_FILE=/data/members.json
